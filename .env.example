# Frontend settings (backlog P0.5-FE-02). Copy to .env.local (git-ignored). Only VITE_* values reach the browser,
# so never put secrets here.

# local | preview | production — anything but production shows a badge in the top bar.
VITE_APP_ENV=local

# Where `npm run dev` / `npm run preview` send /api: the Docker backend (default), the E2E backend
# (http://localhost:8081) or a live tunnel URL (https://<words>.trycloudflare.com) to work without Docker.
VITE_DEV_API_TARGET=http://localhost:8080
# Against the live tunnel, signing in works with a live account, but a page reload signs you out: the live backend
# accepts refresh only from the Vercel origin (PLUTO_ALLOWED_ORIGINS in the backend's .env.live).
